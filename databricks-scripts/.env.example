# Copy to .env:  cp .env.example .env   (.env is gitignored)

# Databricks auth profile used for deployment (from `databricks auth profiles`).
DATABRICKS_CONFIG_PROFILE=agent-dev

# OpenAI API key; stored in a Unity Catalog secret used by the OpenAI model provider service.
OPENAI_API_KEY=sk-...

# Optional overrides (defaults are in databricks.yml)
# OPENAI_MODEL=gpt-6-sol
# UC_CATALOG=agent_workspace_7474653685104191
# UC_SCHEMA=homefix_ai
